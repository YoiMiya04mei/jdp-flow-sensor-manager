# ==============================================================================
# JDP Flow Sensor Manager & Traffic Analyzer - Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server & Application Runtime
# ------------------------------------------------------------------------------
# Set to 'production' for staging and production deployments; 'development' for local coding
NODE_ENV=development
PORT=3000

# ------------------------------------------------------------------------------
# 2. Cryptographic Security & Secrets
# ------------------------------------------------------------------------------
# Used for AES-256-GCM encryption of sensitive device credentials (SNMP secrets, router passwords).
# In production/staging, this MUST be a 32-byte hex string (exactly 64 hexadecimal characters).
# Demo placeholder values are REJECTED at startup in NODE_ENV=production!
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CREDENTIAL_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# JWT Secret for Session Cookie Signing and HMAC validation (minimum 32 characters, high entropy).
# Demo placeholder values containing 'change-in-production' or 'secret-jdp' are REJECTED in production!
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=super-secret-jdp-noc-jwt-token-key-change-in-production

# ------------------------------------------------------------------------------
# 3. Database & Storage Architecture
# ------------------------------------------------------------------------------
# Default zero-config persistent SQLite with Write-Ahead Logging (WAL):
# Both web app and collector daemon processes MUST point to this same file path.
DATABASE_URL=file:./data/jdp_noc.db

# Optional ClickHouse URL for high-volume historical flow archival (Target Profile):
# CLICKHOUSE_URL=http://localhost:8123
# CLICKHOUSE_DB=default
# CLICKHOUSE_USER=default
# CLICKHOUSE_PASSWORD=

# ------------------------------------------------------------------------------
# 4. UDP Flow Ingestion Daemon Configuration
# ------------------------------------------------------------------------------
# Network interface and ports for wire listener:
FLOW_COLLECTOR_HOST=0.0.0.0
FLOW_COLLECTOR_PORTS=2055,6343,9995

# Specific protocol defaults:
NETFLOW_PORT=2055
SFLOW_PORT=6343
IPFIX_PORT=9995

# Heartbeat & sensor inactivity detection threshold (in seconds):
# A sensor transitions to 'stale' or 'inactive' if no packets arrive within this window.
FLOW_STALE_TIMEOUT_SECS=180

# ------------------------------------------------------------------------------
# 5. Router Provisioning & Live Execution Guardrails
# ------------------------------------------------------------------------------
# STRICT DEFAULT-DENY: Live SSH/NETCONF command execution to physical routers
# is DISABLED by default. Set to 'true' only when safe execution has been validated in lab.
ROUTER_LIVE_EXECUTION_ENABLED=false
ROUTER_PROVISIONING_ENABLED=false
ENABLE_LIVE_PROVISIONING=false

# Physical Adapter Lock:
# Live hardware commands are locked to mock adapter unless physical drivers are installed.
ROUTER_PHYSICAL_DRIVER_ENABLED=false
ROUTER_ADAPTER_TYPE=mock

# Strict IP Allowlist for live execution. Any router whose management IP is not
# in this comma-separated list will be rejected by the execution engine.
ROUTER_ALLOWLIST=127.0.0.1,192.168.1.1,10.200.0.1
ROUTER_ALLOWLIST_IPS=127.0.0.1,192.168.1.1,10.200.0.1

# ------------------------------------------------------------------------------
# 6. Development & Seed Controls
# ------------------------------------------------------------------------------
# Set to 'true' ONLY in development mode to seed demo accounts.
# In NODE_ENV=production, this MUST be 'false' (demo seeding throws fatal error).
ENABLE_DEV_SEED=false
