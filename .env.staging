# ==============================================================================
# JDP Flow Sensor Manager & Traffic Analyzer - STAGING ENVIRONMENT CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server & Application Runtime
# ------------------------------------------------------------------------------
NODE_ENV=production
PORT=3000

# ------------------------------------------------------------------------------
# 2. Cryptographic Security & Secrets (STAGING KEYS - NON-DEMO)
# ------------------------------------------------------------------------------
# 32-byte (64 hex characters) AES-256-GCM encryption key
CREDENTIAL_ENCRYPTION_KEY=82e9013a679e97972f82bfb1256c81433d0b04c15cad7ba6fbd4b62376c283d4

# High-entropy JWT Secret (HMAC-SHA256 session token signing)
JWT_SECRET=b40c3d9c472a31ea612f7543e47403defa4c5f785006cf298df0746456affe45cf0c9a80c6534a1fa5ba44292f1074e854bcd924f6ee07249757a3238503238d

# ------------------------------------------------------------------------------
# 3. Database & Shared Storage Bus
# ------------------------------------------------------------------------------
# Both web app and collector daemon MUST point to this shared SQLite WAL file
DATABASE_URL=file:./data/jdp_noc.db

# ------------------------------------------------------------------------------
# 4. UDP Flow Ingestion Daemon Configuration
# ------------------------------------------------------------------------------
FLOW_COLLECTOR_HOST=0.0.0.0
FLOW_COLLECTOR_PORTS=2055,6343,9995
FLOW_STALE_TIMEOUT_SECS=180

# ------------------------------------------------------------------------------
# 5. Router Provisioning Safety Gate (STRICT DEFAULT-DENY)
# ------------------------------------------------------------------------------
# Live execution is strictly locked on staging. Dry-run simulation only.
ROUTER_LIVE_EXECUTION_ENABLED=false
ROUTER_PROVISIONING_ENABLED=false
ROUTER_PHYSICAL_DRIVER_ENABLED=false
ROUTER_ADAPTER_TYPE=mock
ENABLE_LIVE_PROVISIONING=false

# Allowlist for staging lab devices
ROUTER_ALLOWLIST=127.0.0.1,192.168.1.1,10.200.0.1

# ------------------------------------------------------------------------------
# 6. Seed Guard
# ------------------------------------------------------------------------------
# Strictly disable demo seeding on staging deployment
ENABLE_DEV_SEED=false

